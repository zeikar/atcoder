---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import Comments from "../../components/Comments.astro";
import CopyCode from "../../components/CopyCode.astro";
import JsonLd from "../../components/JsonLd.astro";
import TagList from "../../components/TagList.astro";
import Toc from "../../components/Toc";
import Base from "../../layouts/Base.astro";
import { siteConfig } from "../../lib/config";
import { editedADayLater, formatDate } from "../../lib/datetime";
import { postPath, withBase } from "../../lib/links";
import { byNewest } from "../../lib/posts";
import { absoluteUrl, blogPostingJsonLd, shareableImage } from "../../lib/seo";
import { getSite } from "../../lib/site";

export const getStaticPaths = (async () => {
  // in the index's order, so the newer and older posts are the ones listed next to this one
  const posts = (await getCollection("posts")).sort((a, b) =>
    byNewest(a.data, b.data),
  );
  return posts.map((entry, index) => ({
    params: { number: entry.id },
    props: {
      entry,
      newer: posts[index - 1]?.data,
      older: posts[index + 1]?.data,
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const sourceName = siteConfig.source === "issues" ? "Issue" : "Discussion";
const { profile } = await getSite();
const image = shareableImage(data.thumbnail);
---

<Base
  title={`${data.title} - ${siteConfig.websiteTitle}`}
  ogTitle={data.title}
  description={data.excerpt || undefined}
  image={image}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.createdAt} />
    <meta property="article:modified_time" content={data.updatedAt} />
    {data.tags.map((tag) => (
      <meta property="article:tag" content={tag.name} />
    ))}
    <JsonLd
      data={blogPostingJsonLd({
        title: data.title,
        url: absoluteUrl(Astro.url.pathname, Astro.site),
        description: data.excerpt,
        image,
        publishedAt: data.createdAt,
        modifiedAt: data.updatedAt,
        tags: data.tags.map((tag) => tag.name),
        author: { name: profile.name ?? profile.login, url: profile.url },
      })}
    />
  </Fragment>
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <a href={withBase(import.meta.env.BASE_URL, "/")} class="hover:text-fg">
      Posts
    </a>
    <span aria-hidden="true" class="mx-2">
      /
    </span>
    <span>#{data.number}</span>
  </nav>
  <header class="mt-2 flex flex-wrap items-baseline gap-x-3 border-b border-rule pb-6 break-keep break-words">
    <h1 class="min-w-0 text-3xl font-bold tracking-tight sm:text-4xl">
      {data.title}
    </h1>
    <span class="text-3xl text-faint tabular-nums sm:text-4xl">
      #{data.number}
    </span>
  </header>
  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_15.5rem] lg:gap-14">
    <aside class="text-sm lg:sticky lg:top-6 lg:order-last lg:flex lg:max-h-[calc(100vh-3rem)] lg:flex-col lg:self-start">
      <dl class="grid grid-cols-[5rem_minmax(0,1fr)] gap-x-3 gap-y-2.5 border-b border-rule pb-5">
        {data.tags.length > 0 && (
          <>
            <dt class="text-muted">Labels</dt>
            <dd>
              <TagList tags={data.tags} />
            </dd>
          </>
        )}
        <dt class="text-muted">Posted</dt>
        <dd>
          <time datetime={data.createdAt} data-local-date="long">
            {formatDate(data.createdAt, "long", siteConfig.language)}
          </time>
        </dd>
        {editedADayLater(data.createdAt, data.updatedAt) && (
          <>
            <dt class="text-muted">Updated</dt>
            <dd>
              <time datetime={data.updatedAt} data-local-date="long">
                {formatDate(data.updatedAt, "long", siteConfig.language)}
              </time>
            </dd>
          </>
        )}
        <dt class="text-muted">Comments</dt>
        <dd class="tabular-nums">{data.commentCount}</dd>
        <dt class="text-muted">Source</dt>
        <dd>
          <a href={data.url} class="pen-link">
            {sourceName} #{data.number}
          </a>
        </dd>
      </dl>
      {/* below lg the contents would push the post itself off the first screen, so they stay hidden and unhydrated there;
      at lg the sidebar is capped at the screen's height and a long table of contents scrolls inside it */}
      {data.toc.length > 0 && (
        <div class="mt-5 hidden min-h-0 flex-col lg:flex">
          <p class="mb-2 text-muted">Contents</p>
          <Toc items={data.toc} client:media="(min-width: 64rem)" />
        </div>
      )}
    </aside>
    <div class="min-w-0">
      <article class="prose max-w-none break-keep break-words prose-code:before:content-none prose-code:after:content-none">
        <Content />
      </article>
      <CopyCode />
      {(newer || older) && (
        <nav
          aria-label="Newer and older posts"
          class="mt-14 grid gap-4 border-t border-rule pt-6 sm:grid-cols-2 sm:gap-8"
        >
          {[
            { label: "Newer", post: newer },
            { label: "Older", post: older },
          ].map(
            ({ label, post }) =>
              post && (
                <a
                  href={withBase(
                    import.meta.env.BASE_URL,
                    postPath(post.number),
                  )}
                  class:list={[
                    "group block break-keep break-words",
                    // the right column even when there is no newer post, so older posts stay on the same side
                    label === "Older" && "sm:col-start-2 sm:text-right",
                  ]}
                >
                  <span class="mb-0.5 block text-sm text-muted">{label}</span>
                  {/* a stroke drawn under a post's title, as in the index and search results */}
                  <span class="marker-draw font-semibold group-hover:stroke-drawn">
                    {post.title}
                  </span>
                </a>
              ),
          )}
        </nav>
      )}
      <div class="mt-14 border-t border-rule pt-6">
        <Comments number={data.number} />
      </div>
    </div>
  </div>
</Base>
